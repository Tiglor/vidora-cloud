<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.tiglor</groupId>
    <artifactId>vidora-cloud</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>


    <properties>
        <!-- JDK 25 LTS -->
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Spring Boot 4.0.x（Spring Framework 7.0） -->
        <spring-boot.version>4.0.7</spring-boot.version>
        <!-- Spring Cloud 2025.1.x (Oakwood) -> 对应 Boot 4.0.x -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <!-- Spring Cloud Alibaba 2025.1.0.0 -> 对应 Cloud 2025.1.x + Boot 4.0.x -->
        <spring-cloud-alibaba.version>2025.1.0.0</spring-cloud-alibaba.version>

        <!-- Nacos client 3.2.4（SCA 2025.1.0.0 默认捆绑 3.1.1，此处显式覆盖） -->
        <nacos.client.version>3.2.4</nacos.client.version>

        <!-- ORM：Boot4 需要 mybatis-spring 4.x（Spring Framework 7） -->
        <mybatis-plus.version>3.5.17</mybatis-plus.version>
        <mybatis-spring.version>4.0.0</mybatis-spring.version>

        <!-- 接口文档：springdoc 3.x 对应 Boot 4（2.x 是 Boot 3 线） -->
        <springdoc.version>3.1.0</springdoc.version>

        <!-- 对象存储（MinIO / S3 兼容），用于视频文件的上传与存储 -->
        <minio.version>8.5.17</minio.version>
        <!-- RocketMQ 引擎客户端版本。
             不用 rocketmq-spring-boot-starter：2.3.x 按 Spring Framework 5.3.27 编译、未适配 Boot 4，
             其 RocketMQAutoConfiguration 又会被 Boot 4 的 AutoConfiguration.imports 加载。
             改为直接依赖原生 rocketmq-client，自行装配 Producer/Consumer 生命周期（见 video 模块 RocketMqConfig）。
             注意 gRPC 版客户端 rocketmq-client-java 需要 broker 开启 proxy，与当前 namesrv+broker 的 remoting 拓扑不匹配 -->
        <rocketmq.client.version>5.3.2</rocketmq.client.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Lombok 需 >=1.18.38 才支持 JDK 25 -->
        <lombok.version>1.18.42</lombok.version>
        <hutool.version>5.8.32</hutool.version>
        <mysql.version>9.0.0</mysql.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <!-- Maven 3.9.6 默认绑定 surefire 2.12.4，跑不了 JUnit 5（测试会被静默跳过），必须显式钉版本 -->
        <maven-surefire-plugin.version>3.6.0</maven-surefire-plugin.version>
    </properties>

    <modules>
        <module>vidora-common</module>
        <module>vidora-gateway</module>
        <module>vidora-auth</module>
        <module>vidora-modules</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 4 BOM -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud 2025.1 BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- Spring Cloud Alibaba 2025.1.0.0 BOM -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 内部公共模块 -->
            <dependency>
                <groupId>org.tiglor</groupId>
                <artifactId>vidora-common-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 用户/角色/菜单（RBAC）实体与 Mapper：auth 与 system 共用 user_service 库 -->
            <dependency>
                <groupId>org.tiglor</groupId>
                <artifactId>vidora-common-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Redis 缓存与序列化配置：需要 @Cacheable 的服务引入 -->
            <dependency>
                <groupId>org.tiglor</groupId>
                <artifactId>vidora-common-redis</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- 单元测试支撑：脱离 Spring 容器直接 new ServiceImpl 时的 MyBatis-Plus 装配，
                 各业务模块以 test scope 引入，不要放进 main scope -->
            <dependency>
                <groupId>org.tiglor</groupId>
                <artifactId>vidora-common-test</artifactId>
                <version>${project.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- 工具类 -->
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>

            <!-- ORM：Spring Boot 4 专用 starter（解决 DataSourceAutoConfiguration 包路径迁移导致的 @AutoConfigureAfter 失效） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MP 3.5.9+ 起 PaginationInnerInterceptor 被拆到该构件（需分页的服务必须引入） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- 覆盖为支持 Spring Framework 7 的版本 -->
            <dependency>
                <groupId>org.mybatis</groupId>
                <artifactId>mybatis-spring</artifactId>
                <version>${mybatis-spring.version}</version>
            </dependency>
            <!-- MySQL 驱动 -->
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>${mysql.version}</version>
            </dependency>

            <!-- 接口文档 SpringDoc OpenAPI（Boot 4） -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- 对象存储 MinIO（视频上传/下载/存储） -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- RocketMQ 原生客户端（remoting 协议，直连 namesrv + broker） -->
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-client</artifactId>
                <version>${rocketmq.client.version}</version>
            </dependency>
            <!-- Sentinel 流量防护 -->
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
                <version>${spring-cloud-alibaba.version}</version>
            </dependency>

            <!-- Nacos 3.2.4 全家桶：覆盖 SCA 2025.1.0.0 默认的 3.1.1。
                 显式钉住子构件，避免 nacos-client 3.2.4 与子构件 3.1.1 混杂导致 NoSuchMethodError -->
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client</artifactId>
                <version>${nacos.client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-client-basic</artifactId>
                <version>${nacos.client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-auth-plugin</artifactId>
                <version>${nacos.client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-encryption-plugin</artifactId>
                <version>${nacos.client.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.nacos</groupId>
                <artifactId>nacos-log4j2-adapter</artifactId>
                <version>${nacos.client.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <!-- 未继承 spring-boot-starter-parent，需显式开启。
                             Spring Framework 7 已移除 LocalVariableTableParameterNameDiscoverer，
                             没有 -parameters 时 @Cacheable/@PreAuthorize 的 SpEL 参数名（如 "#userId"）无法解析 -->
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
