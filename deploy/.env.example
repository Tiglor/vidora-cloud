# Docker Compose project
COMPOSE_PROJECT_NAME=vidora
IMAGE_PREFIX=vidora
IMAGE_TAG=1.0.0

# Infrastructure versions
NACOS_VERSION=3.2.4
MYSQL_VERSION=8.0
REDIS_VERSION=7
MINIO_VERSION=RELEASE.2024-10-13T13-34-35Z

# Change every credential before sharing a deployment
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=video_platform
TZ=Asia/Shanghai
REDIS_PASSWORD=
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_BUCKET=vidora
JAVA_OPTS=-Xms256m -Xmx512m

