<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.tiglor</groupId>
        <artifactId>vidora-cloud</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vidora-api</artifactId>
    <packaging>pom</packaging>

    <description>
        服务间调用契约层：每个 provider 一个 vidora-api-{服务名} 子模块，接口与 DTO 由**被调用方**拥有并发布，
        调用方只依赖契约 jar，不再手抄字段。契约刻意保持传输层中立（不引 spring-web / feign / dubbo 注解），
        OpenFeign 与 Dubbo 3 可以实现同一份接口。
    </description>

    <modules>
        <module>vidora-api-system</module>
    </modules>
</project>
