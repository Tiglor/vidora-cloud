<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.tiglor</groupId>
        <artifactId>vidora-api</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vidora-api-system</artifactId>
    <packaging>jar</packaging>

    <description>
        system-service（单库 vidora_cloud 的用户与权限节）对外发布的调用契约。
        消费者两条：video-service 经 OpenFeign 用 UserApi 取投稿用户的昵称与头像；
        auth-service 经 Dubbo 用 RemoteUserApi / RemoteClientApi 完成登录、注册与主题设置。
        本模块不引 dubbo 依赖——@DubboService / @DubboReference 只出现在 provider 与 consumer 侧，
        契约因此对传输框架保持中立。
    </description>

    <dependencies>
        <!-- 只为 ApiResult；不引 spring-web，契约因此不绑定任何传输框架的注解 -->
        <dependency>
            <groupId>org.tiglor</groupId>
            <artifactId>vidora-common-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
