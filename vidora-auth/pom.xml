<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.tiglor</groupId>
        <artifactId>vidora-cloud</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>vidora-auth</artifactId>
    <packaging>jar</packaging>
    <name>Vidora Auth</name>
    <description>Login, registration, JWT token and identity authentication</description>

    <dependencies>
        <dependency>
            <groupId>org.tiglor</groupId>
            <artifactId>vidora-common-core</artifactId>
        </dependency>
        <!-- 统一日志：logback 分级滚动 + traceId + @OperLog 操作审计 -->
        <dependency>
            <groupId>org.tiglor</groupId>
            <artifactId>vidora-common-log</artifactId>
        </dependency>
        <!-- system-service 发布的调用契约（RemoteUserApi / RemoteClientApi），本服务是消费方 -->
        <dependency>
            <groupId>org.tiglor</groupId>
            <artifactId>vidora-api-system</artifactId>
        </dependency>
        <!-- RPC：登录/注册/主题设置都要向 system-service 取数，本服务自己不连库 -->
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>
        <!-- 只为了让 Dubbo 启动期的 JSON 实现探测能走完，本工程不用 gson。
             JsonUtils.loadExtensions 用 ServiceLoader 遍历 fastjson2/fastjson/gson/jackson，
             它的 try 只包住 next() 没包住 hasNext()：gson 缺席时加载 GsonImpl 抛的
             NoClassDefFoundError 会从 hasNext() 直接冒出来，服务启动即失败。
             版本由 spring-boot-dependencies 管（2.13.2），不在此显式钉。 -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- 本服务不连库：没有任何 Mapper，所以刻意不引 mybatis-plus starter 与 mysql 驱动。
             引了 starter 而没有 DataSource，MybatisPlusAutoConfiguration 会在启动期直接失败。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <!-- Javadoc → OpenAPI：controller 上的 Javadoc 直接成为接口说明（处理器见根 pom） -->
        <dependency>
            <groupId>com.github.therapi</groupId>
            <artifactId>therapi-runtime-javadoc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-sentinel</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
